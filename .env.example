SMALLTV_HOST=192.168.1.100

CODEX_HOST_LOG_PATH=/home/YOUR_USER/.codex/logs_2.sqlite
CODEX_HOST_LOG_WAL_PATH=/home/YOUR_USER/.codex/logs_2.sqlite-wal
CODEX_HOST_LOG_SHM_PATH=/home/YOUR_USER/.codex/logs_2.sqlite-shm
CODEX_HOST_SESSIONS_PATH=/home/YOUR_USER/.codex/sessions
CODEX_HOST_STATUS_PATH=/home/YOUR_USER/.codex/codex-status.json

CODEX_ICON_URL=https://persistent.oaistatic.com/codex/icon-gif.mp4
CODEX_STATUS_MAX_AGE_SECONDS=420
CODEX_LOOKBACK_DAYS=7
DISPLAY_TZ=America/Sao_Paulo
REFRESH_SECONDS=30
FRAME_MS=700
FRAMES_PER_PAGE=8
MAX_GIF_BYTES=450000
TZ=America/Sao_Paulo
UPLOAD_ENABLED=true
RUN_ONCE=false
HTTP_TIMEOUT=10
GIF_FILENAME=dashboard.gif
OUTPUT_PATH=/var/cache/smalltv-dashboard/dashboard.gif
